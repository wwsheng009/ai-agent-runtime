{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aicli-gateway",
  "version": "0.1.0",
  "identifier": "online.ttai.aicli.gateway",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "gateway-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
