          "placeholder": "123456:ABC-DEF",
          "required": true,
          "type": "secret"
        },
        {
          "default": "polling",
          "key": "mode",
          "label": "接入模式",
          "options": [
            {
              "label": "长轮询",
              "value": "polling"
            },
            {
              "label": "Webhook",
