# chrome-devtools MCP 配置模板（aicli / runtime-server 共用）
#
# 配置文件查找顺序（命中即用）：
#   ./.aicli/mcp.yaml  >  ~/.aicli/mcp.yaml  >  显式 --config-file  >  cwd 逐级向上搜索  >  configs/mcp.yaml
# 生效方式：
#   - 聊天会话内执行 /mcp reload（热重载并重连，重注册工具）
#   - 或命令行 aicli mcp reload / 重启 aicli
# 完整说明见：docs/mcp/chrome-devtools.md
#
# 使用前按需保留【模式 A / B / C】中的一种（其余注释掉）。

mcpServers:
  # ── 模式 A（推荐）：attach 到已打开的浏览器 ─────────────────────────────
  # 前置条件：Chrome/Edge 144+ 运行中，且已开启 chrome://inspect/#remote-debugging，
  #           首次连接时在浏览器弹窗中点击 Allow。
  # 效果：复用真实浏览器窗口/标签页/登录态；MCP 退出不会关闭浏览器。
  chrome-devtools:
    name: chrome-devtools
    description: Chrome DevTools MCP（attach 到已开启 remote debugging 的 Edge/Chrome 实例）
    type: stdio
    trustLevel: local
    maxParallelCalls: 1
    command: npx
    args:
      - -y
      - chrome-devtools-mcp@latest
      - --auto-connect
      - --user-data-dir
      # Edge 默认：%LOCALAPPDATA%\Microsoft\Edge\User Data
      # Chrome 默认：%LOCALAPPDATA%\Google\Chrome\User Data
      - 'C:\Users\<you>\AppData\Local\Microsoft\Edge\User Data'
      - --no-usage-statistics
      - --no-performance-crux
    url: ""
    env: {}
    enabled: true
    disabled: false
    timeout: 2m0s
    maxRetry: 2

global:
  autoConnect: true
  healthCheckInterval: 1m0s
  connectTimeout: 1m0s

# ── 模式 B：自启无头浏览器（不影响日常浏览器） ──────────────────────────
# 说明：--isolated 使用临时 profile；页面/MCP 进程结束即回收。
# 将上面的 args 替换为：
#    args:
#      - -y
#      - chrome-devtools-mcp@latest
#      - --headless
#      - --isolated
#      - --no-usage-statistics
#      - --no-performance-crux

# ── 模式 C：连接手动开启的调试端口（沙箱 / 非 144+ 浏览器） ─────────────
# 浏览器需以调试端口 + 非默认 user-data-dir 启动（Chrome 136+ 强制要求非默认 profile）：
#    & "C:\Program Files\Google\Chrome\Application\chrome.exe" `
#        --remote-debugging-port=9222 --user-data-dir="$env:TEMP\chrome-profile-debug"
# （inspect 模式只暴露 WS 端点、无 /json HTTP 接口，不能用本模式，须用模式 A）
# 将上面的 args 替换为：
#    args:
#      - -y
#      - chrome-devtools-mcp@latest
#      - --browser-url=http://127.0.0.1:9222
#      - --no-usage-statistics
#      - --no-performance-crux
