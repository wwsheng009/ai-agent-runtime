diff --git a/packages/envd/internal/logs/logger.go b/packages/envd/internal/logs/logger.go
index 4d8fbaab..23cc2acb 100644
--- a/packages/envd/internal/logs/logger.go
+++ b/packages/envd/internal/logs/logger.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"io"
 	"os"
+	"strings"
 	"time"
 
 	"github.com/rs/zerolog"
@@ -24,12 +25,22 @@ func NewLogger(ctx context.Context, isNotFC bool, mmdsChan <-chan *host.MMDSOpts
 		exporters = append(exporters, exporter.NewHTTPLogsExporter(ctx, isNotFC, mmdsChan), os.Stdout)
 	}
 
+	// Request payloads can contain file bodies (the bridge's write tool passes
+	// content as an argv element), so debug must not be the default. Operators can
+	// still opt in explicitly with ENVD_LOG_LEVEL=debug.
+	level := zerolog.InfoLevel
+	if raw := strings.TrimSpace(os.Getenv("ENVD_LOG_LEVEL")); raw != "" {
+		if parsed, err := zerolog.ParseLevel(raw); err == nil {
+			level = parsed
+		}
+	}
+
 	l := zerolog.
 		New(io.MultiWriter(exporters...)).
 		With().
 		Timestamp().
 		Logger().
-		Level(zerolog.DebugLevel)
+		Level(level)
 
 	return &l
 }
